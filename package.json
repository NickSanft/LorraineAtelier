{
  "name": "lorraine-atelier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint:noinput && tsc -b && vite build",
    "preview": "vite preview",
