{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorraine Atelier",
  "version": "1.0.0",
  "identifier": "com.divora.lorraineatelier",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lorraine Atelier",
        "url": "index.html",
        "width": 540,
        "height": 460,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      },
      {
        "label": "wallpaper-0",
        "url": "wallpaper.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "resizable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      },
      {
        "label": "wallpaper-1",
        "url": "wallpaper.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "resizable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      },
      {
        "label": "wallpaper-2",
        "url": "wallpaper.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "resizable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      },
      {
        "label": "wallpaper-3",
        "url": "wallpaper.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "resizable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$HOME/**", "$APPDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Copyright © 2026",
    "category": "Utility",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
